---
// Lemon Squeezy checkout links. Replace STORE + the buy IDs with your real
// product variants. The `lemonsqueezy-button` class triggers the hosted
// checkout overlay loaded in Base.astro.
const LS_STORE = "https://ultrspeak.lemonsqueezy.com/buy";

const periods = [
  { id: "quarter", label: "3 months", default: false },
  { id: "year", label: "Yearly", default: true },
  { id: "life", label: "Lifetime", default: false },
];

const proFree = [
  "On-device transcription",
  "English & Chinese",
  "Global hold-to-talk shortcut",
  "Up to 2,000 words per day",
];
const proPaid = [
  "Everything in Free",
  "Unlimited dictation",
  "All writing modes",
  "Custom vocabulary",
  "Searchable history",
];
---

<section id="pricing" class="mx-auto max-w-6xl px-6 py-28">
  <div class="reveal mx-auto mb-12 max-w-2xl text-center">
    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-amber-ink">
      Pricing
    </p>
    <h2 class="font-display text-[clamp(2.4rem,5vw,3.9rem)] leading-[1.04] text-ink-strong">
      Honest pricing. <span class="italic">No lock-in.</span>
    </h2>
    <p class="mx-auto mt-4 max-w-md text-ink2">
      Buy a license key, paste it into the app, done. 14-day refund, no
      questions asked.
    </p>
  </div>

  <div class="price-toggle reveal">
    {
      periods.map((p) => (
        <input
          type="radio"
          name="period"
          id={`period-${p.id}`}
          class="price-input"
          checked={p.default}
        />
      ))
    }

    <!-- Toggle -->
    <div
      class="mx-auto mb-10 flex w-fit gap-1 rounded-full border border-line bg-card p-1 shadow-card"
    >
      {
        periods.map((p) => (
          <label
            for={`period-${p.id}`}
            class="cursor-pointer rounded-full px-5 py-2 text-sm font-medium text-ink2 transition-colors"
          >
            {p.label}
          </label>
        ))
      }
    </div>

    <div class="mx-auto grid max-w-3xl gap-5 md:grid-cols-2">
      <!-- Free -->
      <article class="flex flex-col rounded-3xl border border-line bg-card p-8 shadow-card">
        <h3 class="font-display text-3xl text-ink-strong">Free</h3>
        <p class="mt-1 text-sm text-ink2">Try dictation, no account needed.</p>
        <div class="mt-6 font-display text-5xl text-ink-strong">$0</div>
        <p class="mt-1 text-xs text-ink2">forever</p>
        <a
          href="/#download"
          class="mt-7 rounded-full border border-line px-6 py-3 text-center text-sm font-semibold text-ink-strong transition-colors hover:border-ink2"
        >
          Download free
        </a>
        <ul class="mt-8 space-y-3 border-t border-line pt-6 text-sm">
          {
            proFree.map((f) => (
              <li class="flex items-start gap-3 text-ink2">
                <span class="mt-0.5 text-amber-ink">→</span>
                {f}
              </li>
            ))
          }
        </ul>
      </article>

      <!-- Pro -->
      <article
        class="relative flex flex-col rounded-3xl border-2 border-amber bg-card p-8 shadow-lift"
      >
        <span
          class="absolute -top-3 left-8 rounded-full bg-amber px-3 py-1 text-xs font-semibold text-ink-strong"
          >Most popular</span
        >
        <h3 class="font-display text-3xl text-ink-strong">Pro</h3>
        <p class="mt-1 text-sm text-ink2">Unlimited, for daily drivers.</p>

        <!-- 3 months -->
        <div class="price-block price-quarter">
          <div class="mt-6 flex items-baseline gap-1.5">
            <span class="font-display text-5xl text-ink-strong">$8.49</span>
          </div>
          <p class="mt-1 text-xs text-ink2">billed every 3 months</p>
          <a
            href={`${LS_STORE}/QUARTERLY-ID`}
            class="lemonsqueezy-button mt-7 block rounded-full bg-amber px-6 py-3 text-center text-sm font-semibold text-ink-strong transition-transform hover:-translate-y-0.5"
          >
            Get Pro
          </a>
        </div>
        <!-- Yearly -->
        <div class="price-block price-year">
          <div class="mt-6 flex items-baseline gap-2">
            <span class="font-display text-5xl text-ink-strong">$19.49</span>
            <span
              class="rounded-full bg-amber-soft px-2 py-0.5 text-xs font-semibold text-amber-ink"
              >Save 43%</span
            >
          </div>
          <p class="mt-1 text-xs text-ink2">billed yearly, just $1.62 / month</p>
          <a
            href={`${LS_STORE}/YEARLY-ID`}
            class="lemonsqueezy-button mt-7 block rounded-full bg-amber px-6 py-3 text-center text-sm font-semibold text-ink-strong transition-transform hover:-translate-y-0.5"
          >
            Get Pro
          </a>
        </div>
        <!-- Lifetime -->
        <div class="price-block price-life">
          <div class="mt-6 flex items-baseline gap-1.5">
            <span class="font-display text-5xl text-ink-strong">$199</span>
          </div>
          <p class="mt-1 text-xs text-ink2">one-time, yours forever</p>
          <a
            href={`${LS_STORE}/LIFETIME-ID`}
            class="lemonsqueezy-button mt-7 block rounded-full bg-amber px-6 py-3 text-center text-sm font-semibold text-ink-strong transition-transform hover:-translate-y-0.5"
          >
            Buy Lifetime
          </a>
        </div>

        <ul class="mt-8 space-y-3 border-t border-line pt-6 text-sm">
          {
            proPaid.map((f) => (
              <li class="flex items-start gap-3 text-ink2">
                <span class="mt-0.5 text-amber-ink">→</span>
                {f}
              </li>
            ))
          }
        </ul>
      </article>
    </div>

    <p class="mt-8 text-center text-xs text-ink2">
      Secure checkout via Lemon Squeezy. All taxes included.
    </p>
  </div>
</section>
