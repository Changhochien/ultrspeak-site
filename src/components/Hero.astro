---
import AppShot from "./AppShot.astro";
import appHome from "../assets/screenshots/app-home.jpg";
import type { Locale } from "../i18n/config";
import { getTranslations } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translations = getTranslations(locale);
const t = translations.hero;
---

<section class="relative overflow-hidden" data-home-hero>
  <!-- Soft amber wash -->
  <div
    class="pointer-events-none absolute -top-32 left-1/2 h-[480px] w-[900px] -translate-x-1/2 rounded-full blur-[150px]"
    style="background:radial-gradient(closest-side,oklch(0.785 0.15 72/0.24),transparent)"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-3xl px-6 pb-16 pt-16 text-center sm:pb-20 sm:pt-20 md:pt-28">
    <p
      class="rise mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-card px-3 py-1.5 text-xs font-medium tracking-wide text-ink2 shadow-card sm:mb-8 sm:px-4"
      style="animation-delay:0.04s"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-amber"></span>
      {t.eyebrow}
    </p>

    <h1
      class="rise font-display text-[clamp(2.65rem,12vw,5.8rem)] leading-[0.98] text-ink-strong"
      style="animation-delay:0.1s"
    >
      {t.title}
      <span class="text-amber-ink">{t.titleAccent}</span>
    </h1>

    <p
      data-home-hero-body
      class="rise mx-auto mt-6 max-w-xl text-base leading-relaxed text-ink2 sm:mt-7 sm:text-lg"
      style="animation-delay:0.2s"
    >
      {t.body}
    </p>

    <div
      data-home-hero-actions
      class="rise mt-9 grid auto-rows-fr grid-cols-1 items-stretch justify-center gap-3.5 sm:grid-cols-[12rem_12rem] sm:items-center"
      style="animation-delay:0.3s"
    >
      <a
        href="#download"
        data-hero-download
        data-default-label={t.download}
        data-macos-label={translations.footer.downloadMac}
        data-windows-label={translations.footer.downloadWindows}
        class="box-border inline-flex min-h-14 w-full items-center justify-center rounded-full bg-amber px-8 py-3 text-base font-semibold text-ink-strong shadow-[0_4px_18px_-4px_oklch(0.785_0.15_72/0.6)] transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber sm:min-h-16 sm:py-4"
      >
        <span data-hero-download-label>{t.download}</span>
      </a>
      <a
        href="#modes"
        class="box-border inline-flex min-h-14 w-full items-center justify-center rounded-full border border-line bg-card px-8 py-3 text-base font-semibold text-ink-strong transition-colors hover:border-ink2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber sm:min-h-16 sm:py-4"
      >
        {t.seeItWork}
      </a>
    </div>
  </div>

  <!-- App preview -->
  <div
    class="rise relative mx-auto -mb-20 max-w-3xl px-6"
    style="animation-delay:0.4s"
  >
    <div class="relative">
      <div
        class="absolute -inset-x-5 -top-4 bottom-6 -z-10 rounded-[1.9rem] bg-card/60 ring-1 ring-line"
        aria-hidden="true"
      >
      </div>
      <AppShot
        image={appHome}
        ratio="1001 / 586"
        alt={t.imageAlt}
      />
    </div>
  </div>
</section>

<script>
  import {
    detectDownloadPlatform,
    getDownloadHref,
  } from "../scripts/platform-download";

  type NavigatorWithUserAgentData = Navigator & {
    readonly userAgentData?: { readonly platform?: string };
  };

  const heroDownload =
    document.querySelector<HTMLAnchorElement>("[data-hero-download]");
  const heroDownloadLabel = heroDownload?.querySelector<HTMLElement>(
    "[data-hero-download-label]",
  );

  if (heroDownload && heroDownloadLabel) {
    const browserNavigator = navigator as NavigatorWithUserAgentData;
    const platform = detectDownloadPlatform({
      userAgent: browserNavigator.userAgent,
      platform: browserNavigator.platform,
      userAgentDataPlatform: browserNavigator.userAgentData?.platform,
      maxTouchPoints: browserNavigator.maxTouchPoints,
    });
    const href = getDownloadHref(platform, `hero_${platform}`);

    if (href && platform !== "other") {
      const labelByPlatform = {
        macos: heroDownload.dataset.macosLabel,
        windows: heroDownload.dataset.windowsLabel,
      };
      heroDownload.href = href;
      heroDownloadLabel.textContent =
        labelByPlatform[platform] ??
        heroDownload.dataset.defaultLabel ??
        "";
    }

    heroDownload.dataset.detectedPlatform = platform;
  }
</script>
