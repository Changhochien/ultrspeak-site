---
import Waveform from "./Waveform.astro";
---

<section class="relative overflow-hidden">
  <!-- Soft amber wash -->
  <div
    class="pointer-events-none absolute -top-32 left-1/2 h-[480px] w-[900px] -translate-x-1/2 rounded-full blur-[150px]"
    style="background:radial-gradient(closest-side,oklch(0.785 0.15 72/0.28),transparent)"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-3xl px-6 pb-20 pt-20 text-center md:pt-28">
    <p
      class="rise mb-8 inline-flex items-center gap-2 rounded-full border border-line bg-card px-4 py-1.5 text-xs font-medium tracking-wide text-ink2 shadow-card"
      style="animation-delay:0.04s"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-amber"></span>
      On-device voice dictation for macOS
    </p>

    <h1
      class="rise font-display text-[clamp(3rem,8.5vw,6.4rem)] leading-[0.97] text-ink-strong"
      style="animation-delay:0.1s"
    >
      Speak. It's
      <span class="italic"><span class="marker">already written.</span></span>
    </h1>

    <p
      class="rise mx-auto mt-7 max-w-xl text-lg leading-relaxed text-ink2"
      style="animation-delay:0.2s"
    >
      Hold one key, talk, and clean formatted text lands wherever your cursor
      is. Roughly three times faster than typing, fully private, and it works
      offline.
    </p>

    <div
      class="rise mt-9 flex flex-wrap items-center justify-center gap-3.5"
      style="animation-delay:0.3s"
    >
      <a
        href="#pricing"
        class="rounded-full bg-amber px-7 py-3.5 text-sm font-semibold text-ink-strong shadow-[0_4px_18px_-4px_oklch(0.785_0.15_72/0.6)] transition-transform hover:-translate-y-0.5"
      >
        Download for Mac
      </a>
      <a
        href="#modes"
        class="rounded-full border border-line bg-card px-7 py-3.5 text-sm font-semibold text-ink-strong transition-colors hover:border-ink2"
      >
        See it work
      </a>
    </div>
    <p
      class="rise mt-5 flex items-center justify-center gap-2 text-sm text-ink2"
      style="animation-delay:0.36s"
    >
      Free to try. Press
      <kbd
        class="rounded-md border border-line bg-card px-2 py-0.5 font-mono text-xs text-ink-strong shadow-sm"
        >⌥ Space</kbd
      >
      to dictate.
    </p>
  </div>

  <!-- Live capture mock -->
  <div
    class="rise relative mx-auto -mb-20 max-w-3xl px-6"
    style="animation-delay:0.46s"
  >
    <div
      class="overflow-hidden rounded-2xl border border-line bg-card shadow-lift"
    >
      <div class="flex items-center gap-2 border-b border-line px-5 py-3">
        <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
        <span class="ml-3 font-mono text-xs text-ink2">Slack — #finance</span>
        <span
          class="ml-auto flex items-center gap-1.5 rounded-full bg-amber-soft px-2.5 py-1 font-mono text-[11px] text-amber-ink"
        >
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-amber"></span>
          listening
        </span>
      </div>
      <div class="grid items-center gap-6 p-7 sm:grid-cols-[1fr_auto] sm:p-9">
        <p class="text-left text-xl font-medium leading-snug text-ink-strong md:text-2xl">
          Send the Q3 numbers to the finance channel and
          <span class="font-semibold text-amber-ink">flag anything over budget.</span>
        </p>
        <div class="h-16 w-full sm:h-20 sm:w-56">
          <Waveform bars={38} />
        </div>
      </div>
    </div>
  </div>
</section>
