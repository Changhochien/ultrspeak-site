---
const year = new Date().getFullYear();
---

<footer id="download" class="mx-auto max-w-6xl px-6 py-20">
  <div
    class="relative overflow-hidden rounded-3xl border border-line bg-surface p-12 md:p-16"
  >
    <div
      class="amber-glow pointer-events-none absolute -bottom-32 -right-20 h-80 w-80 rounded-full blur-[120px]"
      style="background:radial-gradient(closest-side,rgba(255,176,0,0.22),transparent)"
      aria-hidden="true"
    >
    </div>
    <h2
      class="font-display text-[clamp(2.5rem,6vw,5rem)] leading-[0.98]"
    >
      Stop typing.<br />
      <span class="italic text-amber">Start speaking.</span>
    </h2>
    <a
      href="#pricing"
      class="mt-8 inline-block rounded-full bg-amber px-8 py-4 text-sm font-semibold text-ink transition-transform hover:-translate-y-0.5"
    >
      Download for Mac
    </a>
  </div>

  <div
    class="mt-12 flex flex-col gap-6 border-t border-line pt-8 text-sm text-muted md:flex-row md:items-center md:justify-between"
  >
    <div class="flex items-center gap-2.5">
      <span class="flex items-end gap-[2px] h-3.5" aria-hidden="true">
        <span class="w-[2.5px] h-2/5 rounded-full bg-amber"></span>
        <span class="w-[2.5px] h-full rounded-full bg-amber"></span>
        <span class="w-[2.5px] h-3/5 rounded-full bg-amber"></span>
      </span>
      <span class="font-semibold text-paper">ultrspeak</span>
      <span>© {year}</span>
    </div>
    <nav class="flex flex-wrap gap-6">
      <a href="/#features" class="link-amber hover:text-paper">Features</a>
      <a href="/#pricing" class="link-amber hover:text-paper">Pricing</a>
      <a href="/#faq" class="link-amber hover:text-paper">FAQ</a>
      <a href="mailto:hello@ultrspeak.com" class="link-amber hover:text-paper"
        >Contact</a
      >
      <a href="/privacy" class="link-amber hover:text-paper">Privacy</a>
    </nav>
  </div>
</footer>
