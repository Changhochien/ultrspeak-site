---
import type { Locale } from "../../i18n/config";
import { getTranslations } from "../../i18n/ui";
import Base from "../../layouts/Base.astro";
import Footer from "../Footer.astro";
import Nav from "../Nav.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).contact;

// Replace with your Formspree form endpoint: https://formspree.io/f/XXXXXXXX
const FORM_ENDPOINT = "https://formspree.io/f/your-form-id";
---

<Base locale={locale} route="contact">
  <Nav locale={locale} route="contact" />
  <main class="mx-auto max-w-2xl px-6 py-20 md:py-28">
    <h1
      class="font-display text-[clamp(2.8rem,7vw,4.6rem)] leading-[1.02] text-ink-strong"
    >
      {t.heading}
    </h1>
    <p class="mt-5 max-w-md text-[0.95rem] leading-relaxed text-ink2">
      {t.intro}
    </p>

    <form
      id="contact-form"
      action={FORM_ENDPOINT}
      method="POST"
      class="mt-14 space-y-6"
      data-sending={t.sending}
      data-sent={t.sent}
      data-error={t.error}
    >
      <div>
        <label
          for="name"
          class="block text-sm font-semibold tracking-tight text-ink-strong"
        >
          {t.name}
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="mt-2 w-full rounded-2xl border border-line bg-card px-4 py-3 text-base text-ink-strong outline-none transition-colors placeholder:text-ink2 focus:border-amber md:text-[0.95rem]"
          placeholder={t.namePlaceholder}
        />
      </div>

      <div>
        <label
          for="email"
          class="block text-sm font-semibold tracking-tight text-ink-strong"
        >
          {t.email}
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="mt-2 w-full rounded-2xl border border-line bg-card px-4 py-3 text-base text-ink-strong outline-none transition-colors placeholder:text-ink2 focus:border-amber md:text-[0.95rem]"
          placeholder={t.emailPlaceholder}
        />
      </div>

      <div>
        <label
          for="message"
          class="block text-sm font-semibold tracking-tight text-ink-strong"
        >
          {t.message}
        </label>
        <textarea
          id="message"
          name="message"
          required
          rows="6"
          class="mt-2 w-full resize-y rounded-2xl border border-line bg-card px-4 py-3 text-base leading-relaxed text-ink-strong outline-none transition-colors placeholder:text-ink2 focus:border-amber md:text-[0.95rem]"
          placeholder={t.messagePlaceholder}></textarea>
      </div>

      <button
        type="submit"
        id="contact-submit"
        class="rounded-full bg-amber px-7 py-4 text-sm font-semibold text-ink-strong transition-transform hover:-translate-y-0.5 disabled:opacity-60 disabled:hover:translate-y-0"
      >
        {t.send}
      </button>

      <p
        id="contact-status"
        class="text-sm leading-relaxed text-ink2"
        role="status"
        aria-live="polite"
      >
      </p>
    </form>

    <div class="mt-14 rounded-2xl border border-line bg-amber-soft/40 p-6">
      <p class="text-sm leading-relaxed text-ink2">
        {t.preferEmail}
        <a href="mailto:hello@ultrspeak.com" class="link-amber text-amber-ink"
          >hello@ultrspeak.com</a
        >{t.refund}
      </p>
    </div>
  </main>
  <Footer locale={locale} />
</Base>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const status = document.getElementById("contact-status");
  const button = document.getElementById(
    "contact-submit",
  ) as HTMLButtonElement;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status || !button) return;

    button.disabled = true;
    status.textContent = form.dataset.sending ?? "";
    status.className = "text-sm leading-relaxed text-ink2";

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (!response.ok) throw new Error("Bad response");

      form.reset();
      status.textContent = form.dataset.sent ?? "";
      status.className =
        "text-sm leading-relaxed font-semibold text-amber-ink";
    } catch {
      status.textContent = form.dataset.error ?? "";
      status.className =
        "text-sm leading-relaxed font-semibold text-amber-ink";
    } finally {
      button.disabled = false;
    }
  });
</script>
