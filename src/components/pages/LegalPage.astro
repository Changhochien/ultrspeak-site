---
import type { Locale } from "../../i18n/config";
import { getTranslations } from "../../i18n/ui";
import Base from "../../layouts/Base.astro";
import Footer from "../Footer.astro";
import Nav from "../Nav.astro";

interface Props {
  locale: Locale;
  page: "privacy" | "terms";
}

const { locale, page } = Astro.props;
const content = getTranslations(locale)[page];
---

<Base locale={locale} route={page}>
  <Nav locale={locale} route={page} />
  <main class="mx-auto max-w-2xl px-6 py-20 md:py-28">
    <h1
      class="font-display text-[clamp(2.8rem,7vw,4.6rem)] leading-[1.02] text-ink-strong"
    >
      {content.heading}
    </h1>
    <p class="mt-5 max-w-md text-[0.95rem] leading-relaxed text-ink2">
      {content.intro}
    </p>
    <p class="mt-3 font-mono text-xs uppercase tracking-wider text-ink2">
      {content.updatedLabel} {content.updated}
    </p>

    <div class="mt-16 space-y-14">
      {
        content.sections.map((section) => (
          <section>
            <h2 class="text-lg font-semibold tracking-tight text-ink-strong">
              {section.h}
            </h2>
            {section.p.map((paragraph) => (
              <p class="mt-3 text-[0.95rem] leading-[1.7] text-ink">
                {paragraph}
              </p>
            ))}
          </section>
        ))
      }
    </div>
  </main>
  <Footer locale={locale} />
</Base>
