---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

// Replace with your Formspree form endpoint: https://formspree.io/f/XXXXXXXX
const FORM_ENDPOINT = "https://formspree.io/f/your-form-id";
---

<Base
  title="Contact — ultrspeak"
  description="Get in touch with the ultrspeak team."
>
  <Nav />
  <main class="mx-auto max-w-2xl px-6 py-20 md:py-28">
    <h1
      class="font-display text-[clamp(2.8rem,7vw,4.6rem)] leading-[1.02] text-ink-strong"
    >
      Contact
    </h1>
    <p class="mt-5 max-w-md text-[0.95rem] leading-relaxed text-ink2">
      Questions, feedback, or trouble with a license key? Send us a note and
      we'll get back to you, usually within a day.
    </p>

    <form
      id="contact-form"
      action={FORM_ENDPOINT}
      method="POST"
      class="mt-14 space-y-6"
    >
      <div>
        <label
          for="name"
          class="block text-sm font-semibold tracking-tight text-ink-strong"
        >
          Name
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="mt-2 w-full rounded-2xl border border-line bg-card px-4 py-3 text-base text-ink-strong outline-none transition-colors placeholder:text-ink2 focus:border-amber md:text-[0.95rem]"
          placeholder="Your name"
        />
      </div>

      <div>
        <label
          for="email"
          class="block text-sm font-semibold tracking-tight text-ink-strong"
        >
          Email
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="mt-2 w-full rounded-2xl border border-line bg-card px-4 py-3 text-base text-ink-strong outline-none transition-colors placeholder:text-ink2 focus:border-amber md:text-[0.95rem]"
          placeholder="you@example.com"
        />
      </div>

      <div>
        <label
          for="message"
          class="block text-sm font-semibold tracking-tight text-ink-strong"
        >
          Message
        </label>
        <textarea
          id="message"
          name="message"
          required
          rows="6"
          class="mt-2 w-full resize-y rounded-2xl border border-line bg-card px-4 py-3 text-base leading-relaxed text-ink-strong outline-none transition-colors placeholder:text-ink2 focus:border-amber md:text-[0.95rem]"
          placeholder="How can we help?"></textarea>
      </div>

      <button
        type="submit"
        id="contact-submit"
        class="rounded-full bg-amber px-7 py-4 text-sm font-semibold text-ink-strong transition-transform hover:-translate-y-0.5 disabled:opacity-60 disabled:hover:translate-y-0"
      >
        Send message
      </button>

      <p
        id="contact-status"
        class="text-sm leading-relaxed text-ink2"
        role="status"
        aria-live="polite"
      >
      </p>
    </form>

    <div class="mt-14 rounded-2xl border border-line bg-amber-soft/40 p-6">
      <p class="text-sm leading-relaxed text-ink2">
        Prefer email? Reach us directly at
        <a href="mailto:hello@ultrspeak.com" class="link-amber text-amber-ink"
          >hello@ultrspeak.com</a
        >. For refunds, email within 14 days of purchase from your checkout
        address.
      </p>
    </div>
  </main>
  <Footer />
</Base>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const status = document.getElementById("contact-status")!;
  const button = document.getElementById(
    "contact-submit",
  ) as HTMLButtonElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    button.disabled = true;
    status.textContent = "Sending…";
    status.className = "text-sm leading-relaxed text-ink2";

    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (res.ok) {
        form.reset();
        status.textContent =
          "Thanks — your message is on its way. We'll reply soon.";
        status.className =
          "text-sm leading-relaxed font-semibold text-amber-ink";
      } else {
        throw new Error("Bad response");
      }
    } catch {
      status.textContent =
        "Something went wrong. Please email hello@ultrspeak.com instead.";
      status.className = "text-sm leading-relaxed font-semibold text-amber-ink";
    } finally {
      button.disabled = false;
    }
  });
</script>
