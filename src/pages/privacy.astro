---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const sections = [
  {
    h: "Your voice stays on your Mac",
    p: "ultrspeak transcribes speech using on-device models. Audio recordings and transcripts are processed locally and are never uploaded to us or any third party.",
  },
  {
    h: "Dictation history",
    p: "Your dictation history is stored locally on your device so you can search and reuse it. You can clear it at any time from the app. We have no access to it.",
  },
  {
    h: "Purchases and licensing",
    p: "Payments and license keys are handled by Lemon Squeezy, our merchant of record. They process your billing details under their own privacy policy. We only receive your email address and license status to provide support.",
  },
  {
    h: "Diagnostics",
    p: "ultrspeak does not collect analytics or telemetry by default. If you choose to send a crash report, it contains no audio or transcript content.",
  },
  {
    h: "Contact",
    p: "Questions about privacy? Email hello@ultrspeak.com and we'll get back to you.",
  },
];
---

<Base title="Privacy — ultrspeak" description="How ultrspeak handles your data.">
  <Nav />
  <main class="mx-auto max-w-2xl px-6 py-28">
    <h1 class="font-display text-[clamp(2.8rem,7vw,4.8rem)] leading-[1.02] text-ink-strong">
      Privacy
    </h1>
    <p class="mt-4 text-sm text-ink2">Last updated: {new Date().getFullYear()}</p>

    <div class="mt-14 space-y-8">
      {
        sections.map((s) => (
          <section class="rounded-2xl border border-line bg-card p-7 shadow-card">
            <h2 class="text-xl font-semibold tracking-tight text-ink-strong">{s.h}</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink2">{s.p}</p>
          </section>
        ))
      }
    </div>
  </main>
  <Footer />
</Base>
