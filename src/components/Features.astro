---
import { Image } from "astro:assets";
import Waveform from "./Waveform.astro";
import appHistory from "../assets/screenshots/app-history.jpeg";
---

<section id="features" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <div class="reveal mb-10 max-w-2xl md:mb-14">
    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-amber-ink">
      Why ultrspeak
    </p>
    <h2 class="font-display text-[clamp(2.4rem,5vw,3.9rem)] leading-[1.04] text-ink-strong">
      Built to feel like thinking out loud.
    </h2>
  </div>

  <div class="grid grid-cols-[minmax(0,1fr)] gap-4 md:grid-cols-12 md:grid-rows-2">
    <!-- Big: on-device -->
    <article
      class="reveal min-w-0 flex flex-col justify-between rounded-3xl border border-line bg-card p-6 shadow-card sm:p-8 md:col-span-7 md:row-span-2"
    >
      <div>
        <span class="font-mono text-xs text-amber-ink">01</span>
        <h3 class="mt-4 text-2xl font-semibold tracking-tight text-ink-strong">
          It never leaves your Mac
        </h3>
        <p class="mt-3 max-w-md leading-relaxed text-ink2">
          Transcription runs on-device with local models. No cloud, no account,
          no upload. ultrspeak works on a plane, in a meeting, anywhere, and
          your voice stays yours.
        </p>
      </div>
      <div
        class="mt-8 flex min-w-0 flex-col gap-4 rounded-2xl border border-line bg-paper p-4 sm:flex-row sm:items-end sm:p-6"
      >
        <div class="h-16 min-w-0 grow overflow-hidden"><Waveform bars={44} /></div>
        <span
          class="shrink-0 self-start rounded-full bg-amber-soft px-3 py-1 font-mono text-xs text-amber-ink sm:self-auto"
          >0 bytes sent</span
        >
      </div>
    </article>

    <!-- Hold to talk -->
    <article
      class="reveal min-w-0 rounded-3xl border border-line bg-card p-6 shadow-card sm:p-8 md:col-span-5"
    >
      <span class="font-mono text-xs text-amber-ink">02</span>
      <h3 class="mt-4 text-xl font-semibold tracking-tight text-ink-strong">
        Hold a key, anywhere
      </h3>
      <p class="mt-3 text-sm leading-relaxed text-ink2">
        One global shortcut works in any text field. The text lands exactly
        where your cursor already is.
      </p>
    </article>

    <!-- Vocabulary -->
    <article
      class="reveal min-w-0 rounded-3xl border border-line bg-card p-6 shadow-card sm:p-8 md:col-span-5"
    >
      <span class="font-mono text-xs text-amber-ink">03</span>
      <h3 class="mt-4 text-xl font-semibold tracking-tight text-ink-strong">
        Knows your words
      </h3>
      <p class="mt-3 text-sm leading-relaxed text-ink2">
        Teach it names, jargon, and product terms once. Your custom vocabulary
        lands right the first time, every time.
      </p>
    </article>

    <!-- Bilingual -->
    <article
      class="reveal min-w-0 rounded-3xl border border-line bg-card p-6 shadow-card sm:p-8 md:col-span-6"
    >
      <span class="font-mono text-xs text-amber-ink">04</span>
      <h3 class="mt-4 text-xl font-semibold tracking-tight text-ink-strong">
        English and Chinese
      </h3>
      <p class="mt-3 text-sm leading-relaxed text-ink2">
        Dedicated routing for Mandarin alongside English, with automatic
        fallback so mixed-language speech stays accurate.
      </p>
    </article>

    <!-- History -->
    <article
      class="reveal min-w-0 flex flex-col rounded-3xl border border-line bg-card p-6 shadow-card sm:p-8 md:col-span-6"
    >
      <span class="font-mono text-xs text-amber-ink">05</span>
      <h3 class="mt-4 text-xl font-semibold tracking-tight text-ink-strong">
        Nothing gets lost
      </h3>
      <p class="mt-3 text-sm leading-relaxed text-ink2">
        Every dictation is saved locally and searchable. Find, copy, or reuse
        anything you have said, then clear it whenever you want.
      </p>
      <div
        class="mt-7 overflow-hidden rounded-2xl ring-1 ring-line shadow-card"
      >
        <Image
          src={appHistory}
          alt="ultrspeak app, searchable History of past dictations"
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 460px, 92vw"
          class="block h-auto w-full"
        />
      </div>
    </article>
  </div>
</section>
