---
import AppShot from "./AppShot.astro";
---

<section class="relative overflow-hidden">
  <!-- Soft amber wash -->
  <div
    class="pointer-events-none absolute -top-32 left-1/2 h-[480px] w-[900px] -translate-x-1/2 rounded-full blur-[150px]"
    style="background:radial-gradient(closest-side,oklch(0.785 0.15 72/0.24),transparent)"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-3xl px-6 pb-20 pt-20 text-center md:pt-28">
    <p
      class="rise mb-8 inline-flex items-center gap-2 rounded-full border border-line bg-card px-4 py-1.5 text-xs font-medium tracking-wide text-ink2 shadow-card"
      style="animation-delay:0.04s"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-amber"></span>
      On-device voice dictation for Mac and Windows
    </p>

    <h1
      class="rise font-display text-[clamp(2.9rem,8vw,5.8rem)] leading-[0.98] text-ink-strong"
      style="animation-delay:0.1s"
    >
      Speak. It's
      <span class="text-amber-ink">already written.</span>
    </h1>

    <p
      class="rise mx-auto mt-7 max-w-xl text-lg leading-relaxed text-ink2"
      style="animation-delay:0.2s"
    >
      Hold one key, talk, and clean formatted text lands wherever your cursor
      is. Roughly three times faster than typing, fully private, and it works
      offline.
    </p>

    <div
      class="rise mt-9 flex flex-wrap items-center justify-center gap-3.5"
      style="animation-delay:0.3s"
    >
      <a
        href="#download"
        class="rounded-full bg-amber px-7 py-3.5 text-sm font-semibold text-ink-strong shadow-[0_4px_18px_-4px_oklch(0.785_0.15_72/0.6)] transition-transform hover:-translate-y-0.5"
      >
        Download
      </a>
      <a
        href="#modes"
        class="rounded-full border border-line bg-card px-7 py-3.5 text-sm font-semibold text-ink-strong transition-colors hover:border-ink2"
      >
        See it work
      </a>
    </div>
    <p
      class="rise mt-5 flex items-center justify-center gap-2 text-sm text-ink2"
      style="animation-delay:0.36s"
    >
      Free to try on Mac and Windows. Press
      <kbd
        class="rounded-md border border-line bg-card px-2 py-0.5 font-mono text-xs text-ink-strong shadow-sm"
        >⌥ Space</kbd
      >
      to dictate.
    </p>
  </div>

  <!-- App preview -->
  <div
    class="rise relative mx-auto -mb-24 max-w-4xl px-6"
    style="animation-delay:0.46s"
  >
    <div class="relative">
      <div
        class="absolute -inset-x-5 -top-4 bottom-6 -z-10 rounded-[1.9rem] bg-card/60 ring-1 ring-line"
        aria-hidden="true"
      >
      </div>
      <AppShot src="/screenshots/app-modes.png" alt="ultrspeak Modes screen" />
    </div>
  </div>
</section>
