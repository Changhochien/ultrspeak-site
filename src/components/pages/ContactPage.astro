---
import type { Locale } from "../../i18n/config";
import { getTranslations } from "../../i18n/ui";
import Base from "../../layouts/Base.astro";
import Footer from "../Footer.astro";
import Nav from "../Nav.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).contact;
const contactAddress = "hello@ultrspeak.com";
---

<Base locale={locale} route="contact">
  <Nav locale={locale} route="contact" />
  <main class="mx-auto max-w-2xl px-6 py-20 md:py-28">
    <h1
      class="font-display text-[clamp(2.8rem,7vw,4.6rem)] leading-[1.02] text-ink-strong"
    >
      {t.heading}
    </h1>
    <p class="mt-5 max-w-md text-[0.95rem] leading-relaxed text-ink2">
      {t.intro}
    </p>
    <p
      id="contact-guidance"
      class="mt-4 max-w-lg rounded-2xl border border-line bg-card px-4 py-3 text-sm leading-relaxed text-ink2"
    >
      {t.draftGuidance}
    </p>

    <form
      id="contact-form"
      action={`mailto:${contactAddress}`}
      method="GET"
      enctype="text/plain"
      class="mt-14 space-y-6"
      aria-describedby="contact-guidance"
      data-subject={t.emailSubject}
      data-draft-opened={t.draftOpened}
      data-open-error={t.fallbackIntro}
      data-copy-success={t.copySuccess}
      data-copy-error={t.copyError}
      data-recipient-label={t.recipientLabel}
      data-subject-label={t.subjectLabel}
      data-name-label={t.name}
      data-email-label={t.email}
      data-message-label={t.message}
    >
      <div>
        <label
          for="name"
          class="block text-sm font-semibold tracking-tight text-ink-strong"
        >
          {t.name}
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="mt-2 w-full rounded-2xl border border-line bg-card px-4 py-3 text-base text-ink-strong outline-none transition-colors placeholder:text-ink2 focus:border-amber md:text-[0.95rem]"
          placeholder={t.namePlaceholder}
        />
      </div>

      <div>
        <label
          for="email"
          class="block text-sm font-semibold tracking-tight text-ink-strong"
        >
          {t.email}
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="mt-2 w-full rounded-2xl border border-line bg-card px-4 py-3 text-base text-ink-strong outline-none transition-colors placeholder:text-ink2 focus:border-amber md:text-[0.95rem]"
          placeholder={t.emailPlaceholder}
        />
      </div>

      <div>
        <label
          for="message"
          class="block text-sm font-semibold tracking-tight text-ink-strong"
        >
          {t.message}
        </label>
        <textarea
          id="message"
          name="message"
          required
          rows="6"
          class="mt-2 w-full resize-y rounded-2xl border border-line bg-card px-4 py-3 text-base leading-relaxed text-ink-strong outline-none transition-colors placeholder:text-ink2 focus:border-amber md:text-[0.95rem]"
          placeholder={t.messagePlaceholder}></textarea>
      </div>

      <button
        type="submit"
        id="contact-submit"
        class="rounded-full bg-amber px-7 py-4 text-sm font-semibold text-ink-strong transition-transform hover:-translate-y-0.5"
      >
        {t.openDraft}
      </button>

      <p
        id="contact-status"
        class="text-sm leading-relaxed text-ink2"
        role="status"
        aria-live="polite"
      >
      </p>

      <section
        id="contact-draft-fallback"
        class="hidden rounded-2xl border border-line bg-card p-5"
        aria-labelledby="contact-draft-heading"
      >
        <h2
          id="contact-draft-heading"
          class="text-base font-semibold text-ink-strong"
        >
          {t.fallbackHeading}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-ink2">
          {t.fallbackIntro}
        </p>
        <textarea
          id="contact-draft"
          rows="8"
          readonly
          class="mt-4 w-full resize-y rounded-xl border border-line bg-paper px-3 py-3 text-sm leading-relaxed text-ink-strong outline-none focus:border-amber"
          aria-label={t.fallbackHeading}></textarea>
        <button
          type="button"
          id="copy-contact-draft"
          class="mt-3 rounded-full border border-ink-strong px-5 py-2.5 text-sm font-semibold text-ink-strong transition-colors hover:bg-ink-strong hover:text-paper"
        >
          {t.copyDraft}
        </button>
      </section>
    </form>

    <div class="mt-14 rounded-2xl border border-line bg-amber-soft/40 p-6">
      <p class="text-sm leading-relaxed text-ink2">
        {t.preferEmail}
        <a href={`mailto:${contactAddress}`} class="link-amber text-amber-ink"
          >{contactAddress}</a
        >{t.refund}
      </p>
    </div>
  </main>
  <Footer locale={locale} />
</Base>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const status = document.getElementById("contact-status");
  const fallback = document.getElementById("contact-draft-fallback");
  const draft = document.getElementById(
    "contact-draft",
  ) as HTMLTextAreaElement;
  const copyButton = document.getElementById(
    "copy-contact-draft",
  ) as HTMLButtonElement;

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!status || !fallback || !draft) return;

    const data = new FormData(form);
    const name = String(data.get("name") ?? "");
    const email = String(data.get("email") ?? "");
    const message = String(data.get("message") ?? "");
    const subject = form.dataset.subject ?? "";
    const recipient = new URL(form.action).pathname;
    const body = [
      `${form.dataset.recipientLabel}: ${recipient}`,
      `${form.dataset.subjectLabel}: ${subject}`,
      "",
      `${form.dataset.nameLabel}: ${name}`,
      `${form.dataset.emailLabel}: ${email}`,
      "",
      `${form.dataset.messageLabel}:`,
      message,
    ].join("\n");

    draft.value = body;
    fallback.classList.remove("hidden");
    status.textContent = form.dataset.draftOpened ?? "";
    status.className =
      "text-sm leading-relaxed font-semibold text-amber-ink";

    const mailto = new URL(form.action);
    mailto.searchParams.set("subject", subject);
    mailto.searchParams.set("body", body);
    const mailtoUrl = mailto.toString();
    if (mailtoUrl.length > 1800) {
      status.textContent = form.dataset.openError ?? "";
      return;
    }

    try {
      window.location.assign(mailtoUrl);
    } catch {
      status.textContent = form.dataset.openError ?? "";
    }
  });

  copyButton?.addEventListener("click", async () => {
    if (!status || !draft) return;

    try {
      await navigator.clipboard.writeText(draft.value);
      status.textContent = form.dataset.copySuccess ?? "";
      status.className =
        "text-sm leading-relaxed font-semibold text-amber-ink";
    } catch {
      draft.focus();
      draft.select();
      let copied = false;
      try {
        copied = document.execCommand("copy");
      } catch {
        copied = false;
      }
      status.textContent = copied
        ? (form.dataset.copySuccess ?? "")
        : (form.dataset.copyError ?? "");
      status.className =
        "text-sm leading-relaxed font-semibold text-amber-ink";
    }
  });
</script>
