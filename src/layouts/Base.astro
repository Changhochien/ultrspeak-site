---
import "@fontsource-variable/hanken-grotesk";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { localeConfig, type Locale, type PublicRoute } from "../i18n/config";
import { getTranslations } from "../i18n/ui";
import {
  getAbsoluteLocalizedUrl,
  getAlternateLinks,
} from "../i18n/utils";

interface Props {
  locale?: Locale;
  route?: PublicRoute;
  title?: string;
  description?: string;
}

const {
  locale = "en",
  route = "home",
  title,
  description,
} = Astro.props;
const t = getTranslations(locale);
const metadata = t.meta[route];
const pageTitle = title ?? metadata.title;
const pageDescription = description ?? metadata.description;
const site = Astro.site ?? new URL("https://ultrspeak.com");
const canonical = getAbsoluteLocalizedUrl(site, locale, route);
const alternateLinks = getAlternateLinks(site, route);
---

<!doctype html>
<html lang={localeConfig[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.jpg", site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ultrspeak app, Home screen" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={new URL("/og.jpg", site).toString()} />
    <meta property="og:locale" content={localeConfig[locale].htmlLang.replace("-", "_")} />
    {
      alternateLinks
        .filter((link) => link.hreflang !== "x-default" && link.locale !== locale)
        .map((link) => (
          <meta
            property="og:locale:alternate"
            content={localeConfig[link.locale].htmlLang.replace("-", "_")}
          />
        ))
    }
    <link rel="canonical" href={canonical} />
    {
      alternateLinks.map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.href} />
      ))
    }
  </head>
  <body>
    <slot />

    <script>
      // Scroll reveal
      const revealElements = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15 },
        );
        revealElements.forEach((element) => io.observe(element));
      } else {
        revealElements.forEach((element) => element.classList.add("in"));
      }

      // Pause looping waveform animations while offscreen
      const waveformHosts = new Set<Element>();
      document
        .querySelectorAll(".wave-bar")
        .forEach((bar) => {
          if (bar.parentElement) waveformHosts.add(bar.parentElement);
        });
      if ("IntersectionObserver" in window) {
        const waveformObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              entry.target.classList.toggle(
                "waveform-paused",
                !entry.isIntersecting,
              );
            }
          },
          { rootMargin: "64px 0px 64px 0px" },
        );
        waveformHosts.forEach((host) => waveformObserver.observe(host));
      }

      document
        .querySelectorAll<HTMLAnchorElement>("[data-language-link]")
        .forEach((link) => {
          const destination = new URL(link.href);
          destination.search = window.location.search;
          destination.hash = window.location.hash;
          link.href = destination.toString();
        });
    </script>
  </body>
</html>
