---
import Waveform from "./Waveform.astro";
import type { Locale } from "../i18n/config";
import { getTranslations } from "../i18n/ui";
import { getLocalizedPath } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const homePath = getLocalizedPath(locale, "home");
const year = new Date().getFullYear();
const copyright = t.footer.copyright.replace("{year}", String(year));
---

<section id="download" class="mx-auto max-w-6xl px-6 pb-12 pt-16 md:pb-16 md:pt-24">
  <div
    class="relative overflow-hidden rounded-[1.75rem] border border-line bg-ink-strong p-7 text-center sm:p-10 md:rounded-[2rem] md:p-20"
  >
    <div
      class="pointer-events-none absolute -bottom-24 left-1/2 h-72 w-[36rem] -translate-x-1/2 rounded-full blur-[120px]"
      style="background:radial-gradient(closest-side,oklch(0.785 0.15 72/0.4),transparent)"
      aria-hidden="true"
    >
    </div>
    <div class="relative">
      <div class="mx-auto mb-8 h-12 w-full max-w-44 opacity-90"><Waveform bars={30} /></div>
      <h2
        class="font-display text-[clamp(2.25rem,10vw,4.6rem)] leading-[1.02] text-paper"
      >
        {t.footer.title} <span class="text-amber">{t.footer.titleAccent}</span>
      </h2>
      <p class="mx-auto mt-4 max-w-sm text-paper/65">
        {t.footer.intro}
      </p>
      <p
        id="platform-download-message"
        class="mx-auto mt-5 min-h-6 max-w-md text-sm font-medium text-paper/80"
        aria-live="polite"
        data-platform-message
        data-macos-message={t.footer.macDetected}
        data-windows-message={t.footer.windowsDetected}
        data-other-message={t.footer.choosePlatform}
      >
        {t.footer.choosePlatform}
      </p>
      <div
        class="mt-5 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap"
        data-platform-downloads
      >
        <a
          href="/download/macos-test?source=footer_macos"
          class="platform-download-option inline-flex min-h-13 w-full items-center justify-center gap-2 rounded-full border px-7 py-4 text-sm font-semibold transition sm:w-auto"
          data-download-option
          data-download-platform="macos"
          data-recommended="true"
          aria-describedby="platform-download-message"
        >
          <span>{t.footer.downloadMac}</span>
          <span class="platform-recommended-badge" data-platform-badge hidden>
            {t.footer.recommended}
          </span>
        </a>
        <a
          href="/download/windows?source=footer_windows"
          class="platform-download-option inline-flex min-h-13 w-full items-center justify-center gap-2 rounded-full border px-7 py-4 text-sm font-semibold transition sm:w-auto"
          data-download-option
          data-download-platform="windows"
          data-recommended="false"
          aria-describedby="platform-download-message"
        >
          <span>{t.footer.downloadWindows}</span>
          <span class="platform-recommended-badge" data-platform-badge hidden>
            {t.footer.recommended}
          </span>
        </a>
      </div>
    </div>
  </div>

  <div
    class="mt-12 flex flex-col gap-6 border-t border-line pt-8 text-sm text-ink2 md:flex-row md:items-center md:justify-between"
  >
    <div class="flex items-center gap-2.5">
      <span class="flex items-end gap-[2.5px] h-3.5" aria-hidden="true">
        <span class="w-[3px] h-2/5 rounded-full bg-amber"></span>
        <span class="w-[3px] h-full rounded-full bg-amber"></span>
        <span class="w-[3px] h-3/5 rounded-full bg-amber"></span>
      </span>
      <span data-footer-copyright>{copyright}</span>
    </div>
    <nav class="flex flex-wrap gap-x-6 gap-y-1" aria-label={t.footer.navAria}>
      <a href={`${homePath}#features`} class="link-amber inline-flex min-h-11 items-center hover:text-ink-strong">{t.nav.features}</a>
      <a href={`${homePath}#how`} class="link-amber inline-flex min-h-11 items-center hover:text-ink-strong">{t.nav.how}</a>
      <a href={`${homePath}#pricing`} class="link-amber inline-flex min-h-11 items-center hover:text-ink-strong">{t.nav.pricing}</a>
      <a href={getLocalizedPath(locale, "contact")} class="link-amber inline-flex min-h-11 items-center hover:text-ink-strong">{t.footer.contact}</a>
      <a href={getLocalizedPath(locale, "privacy")} class="link-amber inline-flex min-h-11 items-center hover:text-ink-strong">{t.footer.privacy}</a>
      <a href={getLocalizedPath(locale, "terms")} class="link-amber inline-flex min-h-11 items-center hover:text-ink-strong">{t.footer.terms}</a>
    </nav>
  </div>
</section>

<style>
  .platform-download-option[data-recommended="true"] {
    border-color: var(--color-amber);
    background: var(--color-amber);
    color: var(--color-ink-strong);
  }

  .platform-download-option[data-recommended="true"]:hover {
    transform: translateY(-0.125rem);
  }

  .platform-download-option[data-recommended="false"] {
    border-color: color-mix(in oklab, var(--color-paper) 25%, transparent);
    background: transparent;
    color: var(--color-paper);
  }

  .platform-download-option[data-recommended="false"]:hover {
    background: color-mix(in oklab, var(--color-paper) 10%, transparent);
  }

  .platform-recommended-badge {
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-ink-strong) 12%, transparent);
    padding: 0.125rem 0.45rem;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.2;
  }
</style>

<script>
  import { detectDownloadPlatform } from "../scripts/platform-download";

  type NavigatorWithUserAgentData = Navigator & {
    readonly userAgentData?: { readonly platform?: string };
  };

  const downloadRoot = document.querySelector<HTMLElement>(
    "[data-platform-downloads]",
  );
  const message = document.querySelector<HTMLElement>(
    "[data-platform-message]",
  );

  if (downloadRoot && message) {
    const browserNavigator = navigator as NavigatorWithUserAgentData;
    const detectedPlatform = detectDownloadPlatform({
      userAgent: browserNavigator.userAgent,
      platform: browserNavigator.platform,
      userAgentDataPlatform: browserNavigator.userAgentData?.platform,
      maxTouchPoints: browserNavigator.maxTouchPoints,
    });
    downloadRoot.dataset.detectedPlatform = detectedPlatform;

    const options = Array.from(
      downloadRoot.querySelectorAll<HTMLElement>("[data-download-option]"),
    );
    const recommended =
      detectedPlatform === "other"
        ? undefined
        : options.find(
            (option) =>
              option.dataset.downloadPlatform === detectedPlatform,
          );

    for (const option of options) {
      const isRecommended = option === recommended;
      option.dataset.recommended = String(isRecommended);
      const badge =
        option.querySelector<HTMLElement>("[data-platform-badge]");
      if (badge) badge.hidden = !isRecommended;
    }

    if (recommended) {
      downloadRoot.prepend(recommended);
    }

    const messageByPlatform = {
      macos: message.dataset.macosMessage,
      windows: message.dataset.windowsMessage,
      other: message.dataset.otherMessage,
    };
    message.textContent =
      messageByPlatform[detectedPlatform] ??
      message.dataset.otherMessage ??
      "";
  }
</script>
