---
import Waveform from "./Waveform.astro";
---

<section class="relative overflow-hidden">
  <!-- Ambient amber glow -->
  <div
    class="amber-glow pointer-events-none absolute -top-40 left-1/2 h-[520px] w-[820px] -translate-x-1/2 rounded-full blur-[140px]"
    style="background:radial-gradient(closest-side,rgba(255,176,0,0.22),transparent)"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6 pb-24 pt-20 md:pt-28">
    <p
      class="rise mb-7 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-xs tracking-wide text-muted"
      style="animation-delay:0.05s"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-amber"></span>
      Voice dictation for macOS — runs fully on-device
    </p>

    <h1
      class="rise font-display text-[clamp(3.2rem,9vw,7.5rem)] leading-[0.95]"
      style="animation-delay:0.12s"
    >
      Speak.<br />
      It's <span class="italic text-amber">already written.</span>
    </h1>

    <p
      class="rise mt-8 max-w-xl text-lg leading-relaxed text-muted"
      style="animation-delay:0.22s"
    >
      ultrspeak turns your voice into clean, formatted text anywhere on your
      Mac. Hold a key, talk, release. It's roughly three times faster than
      typing — and nothing ever leaves your machine.
    </p>

    <div
      class="rise mt-10 flex flex-wrap items-center gap-4"
      style="animation-delay:0.32s"
    >
      <a
        href="#pricing"
        class="rounded-full bg-amber px-7 py-3.5 text-sm font-semibold text-ink transition-transform hover:-translate-y-0.5"
      >
        Download for Mac
      </a>
      <a
        href="#pricing"
        class="link-amber rounded-full border border-line px-7 py-3.5 text-sm font-semibold text-paper transition-colors hover:border-muted"
      >
        See pricing
      </a>
      <span class="flex items-center gap-2 text-sm text-muted">
        Press
        <kbd
          class="rounded-md border border-line bg-surface px-2 py-1 font-mono text-xs text-paper"
          >⌥ Space</kbd
        >
        to talk
      </span>
    </div>

    <!-- Live capture mock -->
    <div
      class="rise mt-16 overflow-hidden rounded-2xl border border-line bg-surface"
      style="animation-delay:0.42s"
    >
      <div class="flex items-center gap-2 border-b border-line px-5 py-3">
        <span class="h-3 w-3 rounded-full bg-line"></span>
        <span class="h-3 w-3 rounded-full bg-line"></span>
        <span class="h-3 w-3 rounded-full bg-line"></span>
        <span class="ml-3 font-mono text-xs text-muted">listening…</span>
      </div>
      <div class="grid items-center gap-8 p-8 md:grid-cols-[1fr_auto]">
        <p class="font-display text-2xl leading-snug text-paper md:text-3xl">
          “Send the Q3 numbers to the finance channel and flag anything
          <span class="italic text-amber">over budget</span>.”
        </p>
        <div class="h-20 w-full md:w-64">
          <Waveform bars={40} />
        </div>
      </div>
    </div>
  </div>
</section>
