---
const apps = [
  "Slack", "Mail", "Notes", "VS Code", "Cursor", "Notion",
  "Messages", "Safari", "Chrome", "Obsidian", "Linear", "Gmail",
];
const row = [...apps, ...apps];
---

<section class="border-y border-line py-8">
  <p class="mb-6 text-center text-xs uppercase tracking-[0.2em] text-muted">
    Works in every app you already use
  </p>
  <div class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24"
      style="background:linear-gradient(to right,var(--color-ink),transparent)"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24"
      style="background:linear-gradient(to left,var(--color-ink),transparent)"
    >
    </div>
    <div class="marquee-track flex w-max gap-12">
      {
        row.map((app) => (
          <span class="font-display text-2xl text-muted/80 whitespace-nowrap">
            {app}
          </span>
        ))
      }
    </div>
  </div>
</section>
