---
import { Image } from "astro:assets";
import stateListening from "../assets/screenshots/state-listening.png";
import stateTranscribing from "../assets/screenshots/state-transcribing.png";
import stateDone from "../assets/screenshots/state-done.png";
import type { Locale } from "../i18n/config";
import { getTranslations } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).how;
const shots = [stateListening, stateTranscribing, stateDone];
const steps = t.steps.map((step, index) => ({
  ...step,
  n: String(index + 1),
  shot: shots[index],
  live: index === 1,
}));
---

<section id="how" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <div class="reveal mb-10 max-w-2xl md:mb-16">
    <h2 class="font-display text-[clamp(2.4rem,5vw,3.9rem)] leading-[1.04] text-ink-strong">
      {t.title}
    </h2>
  </div>

  <ol class="grid gap-4 md:grid-cols-[0.9fr_1.2fr_0.9fr] md:gap-5">
    {
      steps.map((s, i) => (
        <li
          class="reveal relative flex flex-col rounded-3xl border border-line bg-card p-6 shadow-card sm:p-8"
          style={`transition-delay:${i * 110}ms`}
        >
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-amber text-xl font-semibold text-ink-strong">
            {s.n}
          </span>
          <h3 class="mt-6 text-2xl font-semibold tracking-tight text-ink-strong">{s.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink2">{s.body}</p>
          <div
            class="mt-7 flex min-h-[180px] grow flex-col items-center justify-center rounded-2xl border border-line bg-paper px-4 py-6 md:min-h-[210px]"
          >
            {
              s.live && (
                <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-line bg-card px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.12em] text-amber-ink">
                  <span class="h-1.5 w-1.5 rounded-full bg-amber"></span>
                  {t.live}
                </span>
              )
            }
            <Image
              src={s.shot}
              alt={s.alt}
              widths={[320, 520]}
              sizes="(min-width: 768px) 360px, 84vw"
              class={`block h-auto w-full ${s.live ? "max-w-[420px]" : "max-w-[320px]"}`}
            />
          </div>
        </li>
      ))
    }
  </ol>
</section>
