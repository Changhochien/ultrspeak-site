---
import type { Locale } from "../../i18n/config";
import Base from "../../layouts/Base.astro";
import Faq from "../Faq.astro";
import Features from "../Features.astro";
import Footer from "../Footer.astro";
import Hero from "../Hero.astro";
import HowItWorks from "../HowItWorks.astro";
import Integrations from "../Integrations.astro";
import Modes from "../Modes.astro";
import Nav from "../Nav.astro";
import Pricing from "../Pricing.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale} route="home">
  <Nav locale={locale} route="home" />
  <main>
    <Hero locale={locale} />
    <Modes locale={locale} />
    <Features locale={locale} />
    <Integrations locale={locale} />
    <HowItWorks locale={locale} />
    <Pricing locale={locale} />
    <Faq locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
