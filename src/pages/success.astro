---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const steps = [
  "Return to ultrspeak and open Settings, then Account.",
  "Sign in with the same account you used at checkout.",
  "Refresh your account status if Pro does not appear immediately.",
];
---

<Base
  title="Checkout complete — ultrspeak"
  description="Return to ultrspeak to use your Pro subscription."
>
  <Nav />
  <main class="mx-auto max-w-2xl px-6 py-20 text-center md:py-28">
    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-amber-ink">
      Checkout complete
    </p>
    <h1 class="font-display text-[clamp(2.8rem,7vw,4.8rem)] leading-[1.02] text-ink-strong">
      Welcome to ultrspeak.
    </h1>
    <p class="mx-auto mt-5 max-w-md text-ink2">
      We are confirming your subscription. Your Pro access is attached to your
      ultrspeak account automatically.
    </p>

    <ol class="mt-12 space-y-4 text-left">
      {
        steps.map((s, i) => (
          <li class="flex items-start gap-4 rounded-2xl border border-line bg-card p-5 shadow-card sm:p-6">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-amber text-base font-semibold text-ink-strong">
              {i + 1}
            </span>
            <p class="pt-1 text-sm leading-relaxed text-ink-strong">{s}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-8 rounded-2xl border border-line bg-amber-soft/40 p-6">
      <p class="text-sm leading-relaxed text-ink2">
        Need help? Email
        <a href="mailto:hello@ultrspeak.com" class="link-amber text-amber-ink"
          >hello@ultrspeak.com</a
        >
        from the address on your account and we'll take a look.
      </p>
    </div>

    <a
      href="/#download"
      class="mt-10 inline-block rounded-full bg-amber px-8 py-4 text-sm font-semibold text-ink-strong transition-transform hover:-translate-y-0.5"
    >
      Download the app
    </a>
  </main>
  <Footer />
</Base>
