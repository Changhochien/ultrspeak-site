{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ultrspeak-site-preview",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/download/macos",
      "/download/macos/",
      "/download/macos-test",
      "/download/macos-test/",
      "/download/windows",
      "/download/windows/",
      "/updates/macos/*",
      "/macos/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "ultrwispr-updates"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
