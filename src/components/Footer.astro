---
import Waveform from "./Waveform.astro";
const year = new Date().getFullYear();
---

<section id="download" class="mx-auto max-w-6xl px-6 pb-16 pt-24">
  <div
    class="relative overflow-hidden rounded-[2rem] border border-line bg-ink-strong p-12 text-center md:p-20"
  >
    <div
      class="pointer-events-none absolute -bottom-24 left-1/2 h-72 w-[36rem] -translate-x-1/2 rounded-full blur-[120px]"
      style="background:radial-gradient(closest-side,oklch(0.785 0.15 72/0.4),transparent)"
      aria-hidden="true"
    >
    </div>
    <div class="relative">
      <div class="mx-auto mb-8 h-12 w-44 opacity-90"><Waveform bars={30} /></div>
      <h2
        class="font-display text-[clamp(2.6rem,6vw,4.6rem)] leading-[1.02] text-paper"
      >
        Stop typing. <span class="italic">Start speaking.</span>
      </h2>
      <p class="mx-auto mt-4 max-w-sm text-paper/65">
        Free to try on any Apple Silicon Mac. Your voice never leaves it.
      </p>
      <a
        href="#pricing"
        class="mt-8 inline-block rounded-full bg-amber px-8 py-4 text-sm font-semibold text-ink-strong transition-transform hover:-translate-y-0.5"
      >
        Download for Mac
      </a>
    </div>
  </div>

  <div
    class="mt-12 flex flex-col gap-6 border-t border-line pt-8 text-sm text-ink2 md:flex-row md:items-center md:justify-between"
  >
    <div class="flex items-center gap-2.5">
      <span class="flex items-end gap-[2.5px] h-3.5" aria-hidden="true">
        <span class="w-[3px] h-2/5 rounded-full bg-amber"></span>
        <span class="w-[3px] h-full rounded-full bg-amber"></span>
        <span class="w-[3px] h-3/5 rounded-full bg-amber"></span>
      </span>
      <span class="font-semibold text-ink-strong">ultrspeak</span>
      <span>© {year}</span>
    </div>
    <nav class="flex flex-wrap gap-6">
      <a href="/#features" class="link-amber hover:text-ink-strong">Features</a>
      <a href="/#modes" class="link-amber hover:text-ink-strong">Modes</a>
      <a href="/#pricing" class="link-amber hover:text-ink-strong">Pricing</a>
      <a href="/#faq" class="link-amber hover:text-ink-strong">FAQ</a>
      <a href="mailto:hello@ultrspeak.com" class="link-amber hover:text-ink-strong"
        >Contact</a
      >
      <a href="/privacy" class="link-amber hover:text-ink-strong">Privacy</a>
    </nav>
  </div>
</section>
