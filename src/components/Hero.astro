---
import AppShot from "./AppShot.astro";
import appHome from "../assets/screenshots/app-home.jpg";
import type { Locale } from "../i18n/config";
import { getTranslations } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).hero;
---

<section class="relative overflow-hidden" data-home-hero>
  <!-- Soft amber wash -->
  <div
    class="pointer-events-none absolute -top-32 left-1/2 h-[480px] w-[900px] -translate-x-1/2 rounded-full blur-[150px]"
    style="background:radial-gradient(closest-side,oklch(0.785 0.15 72/0.24),transparent)"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-3xl px-6 pb-16 pt-16 text-center sm:pb-20 sm:pt-20 md:pt-28">
    <p
      class="rise mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-card px-3 py-1.5 text-xs font-medium tracking-wide text-ink2 shadow-card sm:mb-8 sm:px-4"
      style="animation-delay:0.04s"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-amber"></span>
      {t.eyebrow}
    </p>

    <h1
      class="rise font-display text-[clamp(2.65rem,12vw,5.8rem)] leading-[0.98] text-ink-strong"
      style="animation-delay:0.1s"
    >
      {t.title}
      <span class="text-amber-ink">{t.titleAccent}</span>
    </h1>

    <p
      class="rise mx-auto mt-6 max-w-xl text-base leading-relaxed text-ink2 sm:mt-7 sm:text-lg"
      style="animation-delay:0.2s"
    >
      {t.body}
    </p>

    <div
      class="rise mt-9 flex flex-wrap items-center justify-center gap-3.5"
      style="animation-delay:0.3s"
    >
      <a
        href="#download"
        class="rounded-full bg-amber px-7 py-3.5 text-sm font-semibold text-ink-strong shadow-[0_4px_18px_-4px_oklch(0.785_0.15_72/0.6)] transition-transform hover:-translate-y-0.5"
      >
        {t.download}
      </a>
      <a
        href="#modes"
        class="rounded-full border border-line bg-card px-7 py-3.5 text-sm font-semibold text-ink-strong transition-colors hover:border-ink2"
      >
        {t.seeItWork}
      </a>
    </div>
    <p
      data-home-hero-qualification
      class="rise mx-auto mt-5 max-w-md text-sm leading-relaxed text-ink2"
      style="animation-delay:0.36s"
    >
      {t.trialBefore}
      <kbd
        class="mx-1 inline-block whitespace-nowrap rounded-md border border-line bg-card px-2 py-0.5 font-mono text-xs text-ink-strong shadow-sm"
        >⌥ Space / Alt + Space</kbd
      >
      {t.trialAfter}
    </p>
  </div>

  <!-- App preview -->
  <div
    class="rise relative mx-auto -mb-20 max-w-3xl px-6"
    style="animation-delay:0.46s"
  >
    <div class="relative">
      <div
        class="absolute -inset-x-5 -top-4 bottom-6 -z-10 rounded-[1.9rem] bg-card/60 ring-1 ring-line"
        aria-hidden="true"
      >
      </div>
      <AppShot
        image={appHome}
        ratio="1001 / 586"
        alt={t.imageAlt}
      />
    </div>
  </div>
</section>
