---
import type { Locale } from "../i18n/config";
import { getTranslations } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).faq;
---

<section id="faq" class="border-t border-line bg-card">
  <div class="mx-auto max-w-3xl px-6 py-20 md:py-28">
    <h2
      class="reveal mb-10 font-display text-[clamp(2.4rem,5vw,3.9rem)] leading-[1.04] text-ink-strong md:mb-12"
    >
      {t.title}
    </h2>

    <div class="divide-y divide-line border-y border-line">
      {
        t.items.map((f) => (
          <details class="reveal group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-medium text-ink-strong">
              {f.q}
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-amber-soft text-xl text-amber-ink transition-transform group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="pb-6 text-sm leading-relaxed text-ink2">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
